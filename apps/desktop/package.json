{
  "name": "@screenplay/desktop",
  "version": "0.1.0-beta.4",
  "description": "The screenwriting app: Electron, React and the shared screenplay engine",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test --test-timeout=120000 'test/**/*.test.ts'",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "package": "npm run build && node scripts/package.mjs",
    "icon": "sh scripts/make-icon.sh",
    "test:browser-qol": "node scripts/qol-browser.mjs",
    "test:browser": "SCREENPLAY_HARDENING=1 node scripts/qol-browser.mjs && node scripts/phone-browser-acceptance.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@screenplay/dictation": "0.1.0",
    "@screenplay/engine": "0.1.0",
    "@screenplay/relay": "0.1.0",
    "jose": "6.2.12",
    "lib0": "^0.2.119",
    "pdf-lib": "^1.17.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "electron": "44.2.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
