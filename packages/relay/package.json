{
  "name": "@screenplay/relay",
  "version": "0.1.0",
  "description": "A self-hostable WebSocket relay for live co-writing: the y-websocket protocol with room keys and read-only access",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./protocol": "./src/protocol.ts"
  },
  "bin": {
    "screenplay-relay": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test --test-timeout=120000 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
